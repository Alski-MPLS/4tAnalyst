# credentials.yaml.example
#
# Copy this file to credentials.yaml and fill in real values.
# credentials.yaml is gitignored and must never be committed.
#
# The MCP servers load this file at startup via the CREDENTIALS_FILE env var
# (defaults to <repo-root>/credentials.yaml when not set).

fortimanager:
  # List of FortiManager hosts in order of preference (primary first).
  # api_key must come from a "REST API Administrator" account in FortiManager
  # (System Settings > Administrators > Create New > REST API Administrator).
  # That account has no password — the key shown/regenerated on its config
  # page is sent as an "Authorization: Bearer" header on every call. A
  # regular admin's password will NOT work here.
  # Also check that account's Trusted Hosts field includes this host's
  # egress IP, or FortiManager will silently reject the key.
  hosts:
    - host: "fmg-site-a.internal.example.com"  # or IP
      api_key: "CHANGEME"
    - host: "fmg-site-b.internal.example.com"
      api_key: "CHANGEME"
  port: 443
  verify_ssl: true
  # FortiManager version — controls any path/behaviour differences (7.4 vs 7.6)
  version: "7.4"

server:
  # Set to false to disable per-token ADOM filtering entirely (all tokens get full access).
  # Defaults to true (fail-closed) when absent. Set to false only for a single-team
  # deployment where all engineers should have full access.
  adom_restriction: true

  # Legacy admin token — always has full access regardless of the tokens list.
  # Used by __main__.py as the primary token when FW_ANALYST_TOKEN env is not set.
  # Generate: openssl rand -hex 32
  auth_token: "CHANGEME"

  # Per-engineer tokens with ADOM restrictions.
  # Each token must be unique. label is for log/audit readability only.
  # adoms: ["*"] gives full access (equivalent to auth_token).
  # adoms: ["OT-ADOM", "GAS-ADOM"] restricts to those ADOMs only.
  # Omit this section (or leave as []) if all engineers share auth_token.
  tokens:
    - token: "CHANGEME-engineer-1"
      label: "engineer-name"
      adoms: ["OT-ADOM"]
    - token: "CHANGEME-admin"
      label: "admin-name"
      adoms: ["*"]

  # Host-header values (for DNS-rebinding protection) accepted on the
  # engineers' connection URL — e.g. "central-server.internal.example.com:8000"
  # or a wildcard port "central-server:*". Comma-separated list; the
  # FW_ANALYST_ALLOWED_HOSTS env var (comma-separated), if set, overrides this.
  #
  # The MCP SDK's default (localhost/127.0.0.1/[::1] only) rejects every
  # engineer connecting via the deployed hostname — set this before the server
  # is reachable from anywhere but localhost.
  #
  # Examples: ["central-server.internal.example.com:8000"], ["10.1.5.62:*"]
  allowed_hosts: []

zone_policy:
  # Base URL for the 4THealth external zone policy API
  base_url: "https://<4thealth-hostname>"
  # Static Bearer token — value is "4th_<token>" issued by the 4THealth admin
  token: "CHANGEME"
  # Set to false when the server uses a self-signed TLS certificate (typical for internal hosts)
  verify_ssl: false
  # Per-request timeout in seconds
  timeout: 30
