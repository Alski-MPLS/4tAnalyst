# credentials.yaml.example
#
# Copy this file to credentials.yaml and fill in real values.
# credentials.yaml is gitignored and must never be committed.
#
# The MCP servers load this file at startup via the CREDENTIALS_FILE env var
# (defaults to <repo-root>/credentials.yaml when not set).

fortimanager:
  # List of FortiManager hosts in order of preference (primary first).
  # api_key must come from a "REST API Administrator" account in FortiManager
  # (System Settings > Administrators > Create New > REST API Administrator).
  # That account has no password — the key shown/regenerated on its config
  # page is sent as an "Authorization: Bearer" header on every call. A
  # regular admin's password will NOT work here.
  # Also check that account's Trusted Hosts field includes this host's
  # egress IP, or FortiManager will silently reject the key.
  hosts:
    - host: "fmg-site-a.internal.example.com"  # or IP
      api_key: "CHANGEME"
    - host: "fmg-site-b.internal.example.com"
      api_key: "CHANGEME"
  port: 443
  verify_ssl: true
  # FortiManager version — controls any path/behaviour differences (7.4 vs 7.6)
  version: "7.4"

server:
  # Static bearer token engineers' Claude Code clients must present to the
  # unified server (fwanalyst_server) in HTTP mode. Generate a long random
  # value (e.g. `openssl rand -hex 32`). The FW_ANALYST_TOKEN env var, if
  # set, overrides this. The server refuses to start in HTTP mode when no
  # token is configured. Interim control until per-engineer AD/Entra
  # identity lands in Phase 4.
  auth_token: "CHANGEME"
  # Host-header values accepted from engineers' connection URL, for DNS-
  # rebinding protection (mcp SDK TransportSecuritySettings). This is what
  # clients put in their URL — NOT their source IP. The FW_ANALYST_ALLOWED_HOSTS
  # env var (comma-separated), if set, overrides this. Leaving this empty
  # keeps the SDK default (localhost/127.0.0.1/[::1] only), which rejects
  # every engineer connecting via the real deployed hostname — set this
  # before the server is reachable from anywhere but localhost.
  # Examples: ["central-server.internal.example.com:8000"], ["10.1.5.62:*"]
  allowed_hosts: []

zone_policy:
  # Base URL for the 4THealth external zone policy API
  base_url: "https://4thealth.internal.example.com"
  # Static Bearer token — value is "4th_<token>" issued by the 4THealth admin
  token: "CHANGEME"
  # Set to false when the server uses a self-signed TLS certificate (typical for internal hosts)
  verify_ssl: false
  # Per-request timeout in seconds
  timeout: 30
